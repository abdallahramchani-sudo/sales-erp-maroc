generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  SALES
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  CHECK
  DIRECT_DEBIT
  OTHER
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  role         Role      @default(SALES)
  createdAt    DateTime  @default(now())
  quotes       Quote[]
  orders       Order[]
  auditLogs    AuditLog[]
}

model CompanySettings {
  id               String   @id @default("default")
  legalName        String
  defaultCurrency  String   @default("MAD")
  vatDefault       Decimal  @default(20) @db.Decimal(5,2)
  ice              String?
  ifNumber         String?
  rc               String?
  taxProfessional  String?
  address          String?
  city             String?
  phone            String?
  email            String?
  invoicePrefix    String   @default("FAC-")
  quotePrefix      String   @default("DEV-")
  orderPrefix      String   @default("CMD-")
  updatedAt        DateTime @updatedAt
}

model Customer {
  id               String    @id @default(cuid())
  companyName      String
  contactName      String?
  email            String?
  phone            String?
  address          String?
  city             String?
  ice              String?
  ifNumber         String?
  rc               String?
  taxProfessional  String?
  vatNumber        String?
  country          String    @default("Maroc")
  status           String    @default("ACTIVE")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  quotes           Quote[]
  orders           Order[]
  invoices         Invoice[]
}

model Product {
  id              String          @id @default(cuid())
  sku             String          @unique
  name            String
  category        String?
  price           Decimal         @db.Decimal(12,2)
  taxRate         Decimal         @default(20) @db.Decimal(5,2)
  stock           Int             @default(0)
  lowStockThreshold Int           @default(5)
  active          Boolean         @default(true)
  items           QuoteItem[]
  orderItems      OrderItem[]
  invoiceItems    InvoiceItem[]
  stockMovements  StockMovement[]
  createdAt       DateTime        @default(now())
}

model Quote {
  id          String       @id @default(cuid())
  number      String       @unique
  customerId  String
  salesId     String?
  status      QuoteStatus  @default(DRAFT)
  subtotal    Decimal      @db.Decimal(12,2)
  tax         Decimal      @db.Decimal(12,2)
  total       Decimal      @db.Decimal(12,2)
  validUntil  DateTime?
  notes       String?
  createdAt   DateTime     @default(now())
  customer    Customer     @relation(fields: [customerId], references: [id])
  sales       User?        @relation(fields: [salesId], references: [id])
  items       QuoteItem[]
  order       Order?
}

model QuoteItem {
  id          String   @id @default(cuid())
  quoteId     String
  productId   String
  description String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12,2)
  taxRate     Decimal  @db.Decimal(5,2)
  total       Decimal  @db.Decimal(12,2)
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])
}

model Order {
  id              String       @id @default(cuid())
  number          String       @unique
  customerId      String
  salesId         String?
  quoteId         String?      @unique
  status          OrderStatus  @default(DRAFT)
  subtotal        Decimal      @db.Decimal(12,2)
  tax             Decimal      @db.Decimal(12,2)
  total           Decimal      @db.Decimal(12,2)
  deliveryAddress String?
  notes           String?
  createdAt       DateTime     @default(now())
  customer        Customer     @relation(fields: [customerId], references: [id])
  sales           User?        @relation(fields: [salesId], references: [id])
  quote           Quote?       @relation(fields: [quoteId], references: [id])
  items           OrderItem[]
  invoice         Invoice?
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String
  description String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12,2)
  taxRate     Decimal  @db.Decimal(5,2)
  total       Decimal  @db.Decimal(12,2)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])
}

model Invoice {
  id          String         @id @default(cuid())
  number      String         @unique
  customerId  String
  orderId     String?        @unique
  status      InvoiceStatus  @default(DRAFT)
  subtotal    Decimal        @db.Decimal(12,2)
  tax         Decimal        @db.Decimal(12,2)
  total       Decimal        @db.Decimal(12,2)
  dueDate     DateTime?
  issuedAt    DateTime?
  notes       String?
  createdAt   DateTime       @default(now())
  customer    Customer      @relation(fields: [customerId], references: [id])
  order       Order?         @relation(fields: [orderId], references: [id])
  items       InvoiceItem[]
  payments    Payment[]
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  productId   String
  description String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12,2)
  taxRate     Decimal  @db.Decimal(5,2)
  total       Decimal  @db.Decimal(12,2)
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])
}

model Payment {
  id          String        @id @default(cuid())
  invoiceId   String
  amount      Decimal       @db.Decimal(12,2)
  method      PaymentMethod  @default(TRANSFER)
  reference   String?
  paidAt      DateTime      @default(now())
  invoice     Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model StockMovement {
  id         String   @id @default(cuid())
  productId  String
  quantity   Int
  reason     String
  reference  String?
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id])
}

model AuditLog {
  id         String    @id @default(cuid())
  action     String
  entity     String
  entityId   String?
  userId     String?
  metadata   String?
  createdAt  DateTime  @default(now())
  user       User?     @relation(fields: [userId], references: [id])
}
